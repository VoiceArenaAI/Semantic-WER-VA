        "equal": true,
        "note": "filled pause"
      },
      {
        "sentence": "⟨ uhum ⟩ faz sentido",
        "equal": true,
        "note": "non-lexical backchannel"
      },
      {
        "sentence": "foi muito engraçado ⟨ haha ⟩",
        "equal": true,
        "note": "laughter"
      },
